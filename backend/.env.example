# Copiar a .env y completar con valores reales. NUNCA commitear el .env.
#
# Este proyecto ya NO tiene servidor: es el toolkit de base de datos del
# SIGEP UNP (migraciones, scripts y pruebas del RLS). La aplicación web
# habla directo con Supabase desde el navegador; lo único que hace falta
# acá es la conexión para correr las migraciones y los scripts.

# --- Base de datos ----------------------------------------------------------
# Cadena de conexión de PostgreSQL (Supabase). La URL ya incluye usuario y
# contraseña, p. ej.: postgresql://usuario:clave@host:5432/postgres
# Usar el POOLER, no el host directo: el host directo es IPv6-only y no
# resuelve en la mayoría de las redes.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Dominio de acceso ------------------------------------------------------
# Sufijo del email con el que se completa el usuario al iniciar sesión.
# Solo lo usa `npm run db:crear-cuenta` para crear la cuenta de Auth.
AUTH_DOMINIO=unp.edu.py

# --- SSL de Postgres --------------------------------------------------------
# Las conexiones de estos scripts usan SSL sin verificar el certificado, que
# es lo que pide Supabase. Si el Postgres es local y no tiene TLS:
# (no aplica a los scripts: el SSL se activa en el propio código)
# DATABASE_SSL=disable
